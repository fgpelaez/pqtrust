    {
      "id": "docs_superpowers_plans_2026_08_16_pqtrust_phase1_two_level_hierarchy",
      "label": "Two-level CA hierarchy (root / intermediate / end-entity)",
      "file_type": "rationale",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/plans/2026-08-16-pqtrust-phase1.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "An offline-capable ML-DSA-87 root is unsealed only to sign intermediates and CRLs, while the ML-DSA-65 intermediate issues end-entity certificates online; validity ladder 10y/5y/397d mirrors CA/B-forum-like hygiene."
    },
    {
      "id": "docs_superpowers_plans_2026_08_16_pqtrust_phase1_pure_sign",
      "label": "Pure-sign encoding mode (absent parameters, raw SPKI)",
      "file_type": "rationale",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/plans/2026-08-16-pqtrust-phase1.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "draft-ietf-lamps-dilithium-certificates requires AlgorithmIdentifier parameters absent and public keys raw in the SPKI BIT STRING; pure-sign mode with an empty context string matches how ML-DSA is used in X.509."
    },
    {
      "id": "docs_superpowers_plans_2026_08_16_pqtrust_phase1_sealed_envelope",
      "label": "Sealed key envelope (AAD-bound JSON)",
      "file_type": "rationale",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/plans/2026-08-16-pqtrust-phase1.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A versioned JSON envelope is inspectable; AES-GCM additional authenticated data binds the algorithm name so a sealed key cannot be silently reinterpreted under another algorithm."
    },
    {
      "id": "docs_superpowers_plans_2026_08_16_pqtrust_phase1_lazy_crl",
      "label": "Lazy CRL regeneration with caching",
      "file_type": "rationale",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/plans/2026-08-16-pqtrust-phase1.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "CRLs regenerate lazily and are cached per CA, so the CA passphrase (an Argon2id unseal) is only needed when a rebuild is genuinely required."
    },
    {
      "id": "docs_superpowers_plans_2026_08_16_pqtrust_phase1_strictness",
      "label": "Strictness policy (hard errors, never warnings)",
      "file_type": "rationale",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/plans/2026-08-16-pqtrust-phase1.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Malformed DER, unknown critical extensions, algorithm/profile mismatches and pathlen violations are always hard errors, never warnings, so trust decisions never degrade silently."
    },
    {
      "id": "docs_superpowers_specs_2026_08_16_pqtrust_design_agpl",
      "label": "AGPL-3.0 license",
      "file_type": "rationale",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/specs/2026-08-16-pqtrust-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "AGPL preserves the future open-core/commercial model: anyone can self-host and audit, but a cloud vendor cannot offer pqtrust as a competing managed service without releasing changes; easy to relax to Apache-2.0 later, hard to go the other way."
    },
    {
      "id": "docs_superpowers_specs_2026_08_16_pqtrust_design_open_core",
      "label": "Open-core commercialization boundary",
      "file_type": "rationale",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/specs/2026-08-16-pqtrust-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The API is versioned (/v1), keystore.Backend is already an interface, all state flows through store, and issuance/revocation events are the natural hook for audit logging and metering — the commercial path stays open without adding scope now."
    }
  ],
