  "nodes": [
    {
      "id": "docs_superpowers_specs_2026_08_16_pqtrust_design_spec",
      "label": "pqtrust design spec (2026-08-16)",
      "file_type": "document",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/specs/2026-08-16-pqtrust-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Dual goal: a professional portfolio piece demonstrating PQC engineering depth (X.509 internals, FIPS 204/205, service design) and a foundation that can be commercialized later as an open-core product."
    },
    {
      "id": "docs_superpowers_plans_2026_08_16_pqtrust_phase1_plan",
      "label": "pqtrust Phase 1 implementation plan",
      "file_type": "document",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/plans/2026-08-16-pqtrust-phase1.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Bottom-up build of six independent internal packages, each depending only on packages below it and tested in isolation, proven correct by NIST ACVP vectors and an OpenSSL 3.5 interop job."
    },
    {
      "id": "docs_superpowers_plans_2026_08_16_pqtrust_phase1_pqx509",
      "label": "pqx509 (pure DER X.509 layer)",
      "file_type": "code",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/plans/2026-08-16-pqtrust-phase1.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Go's crypto/x509 rejects unknown PQC signature algorithm OIDs, so a from-scratch DER build/parse/verify layer on encoding/asn1 is required; it deliberately does no I/O and holds no state so every higher package can depend on it."
    },
    {
      "id": "docs_superpowers_plans_2026_08_16_pqtrust_phase1_keystore",
      "label": "keystore (sealed private key storage)",
      "file_type": "code",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/plans/2026-08-16-pqtrust-phase1.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Private keys are sealed with AES-256-GCM under a wrapping key derived from the passphrase via Argon2id; the Backend interface keeps an HSM/PKCS#11 path open."
    },
    {
      "id": "docs_superpowers_plans_2026_08_16_pqtrust_phase1_store",
      "label": "store (SQLite persistence)",
      "file_type": "code",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/plans/2026-08-16-pqtrust-phase1.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "SQLite via modernc.org/sqlite is pure Go and embedded (zero ops); the schema deliberately holds no pqx509 types so a future multi-tenant schema can be introduced here alone."
    },
    {
      "id": "docs_superpowers_plans_2026_08_16_pqtrust_phase1_config",
      "label": "config (YAML + environment)",
      "file_type": "code",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/plans/2026-08-16-pqtrust-phase1.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "yaml.v3 decoder with KnownFields(true) turns a typo'd config key into a hard error instead of silently ignoring it."
    },
