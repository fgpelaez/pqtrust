    {
      "id": "docs_superpowers_specs_2026_08_16_pqtrust_design_x25519mlkem768",
      "label": "X25519MLKEM768 hybrid key exchange",
      "file_type": "concept",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/specs/2026-08-16-pqtrust-design.md",
