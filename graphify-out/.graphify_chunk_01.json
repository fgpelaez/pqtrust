    {
      "id": "docs_superpowers_plans_2026_08_16_pqtrust_phase1_acvp",
      "label": "NIST ACVP ML-DSA vectors",
      "file_type": "concept",
      "source_file": "/home/fernando/Escritorio/pqtrust/docs/superpowers/plans/2026-08-16-pqtrust-phase1.md",
